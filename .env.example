# ── Servidor ──────────────────────────────────────────────────────────────────

# Porta do backend — obrigatória (usada como bind interno e porta publicada no Docker Compose)
BACKEND_PORT=3000

# ── Banco de Dados ─────────────────────────────────────────────────────────────

POSTGRES_DB=certy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Porta publicada no host pelo docker-compose.db.yml
POSTGRES_HOST_PORT=5432
# Pasta local para bind mount do volume Postgres (docker compose)
POSTGRES_DATA_DIR=./data/postgres

# URL de conexão ao PostgreSQL
# Backend em Docker + DB em Docker (docker-compose.yml):
DATABASE_URL=postgres://postgres:postgres@db:5432/certy
# Backend local + DB em Docker (docker-compose.db.yml):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/certy

# ── Segurança e Proxy ─────────────────────────────────────────────────────────

# Token compartilhado com o proxy; se definido, o backend exige o header
# X-Certy-Proxy-Token: <token> em todas as rotas de certificados.
PROXY_SHARED_TOKEN=change-me-in-production

# Chave secreta do Cloudflare Turnstile.
# Se vazia, a verificação do desafio é desativada (útil em dev).
# Chaves de teste (sempre aprovam): site=1x00000000000000000000AA / secret=1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# ── Validação de E-mail ───────────────────────────────────────────────────────

# Endpoint Likn para validação de formato/DNS/disposable do e-mail
EMAIL_VALIDATION_API_URL=https://api.likn.dev/v1/public/email-validation/validate
EMAIL_VALIDATION_TIMEOUT_MS=4500

# ── Verificação por Código ────────────────────────────────────────────────────

# Segredo para HMAC do código de verificação — mude em produção
EMAIL_VERIFICATION_SECRET=change-me-in-production
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_MAX_RESENDS=3
EMAIL_VERIFICATION_RESEND_INTERVAL_MINUTES=10

# ── Envio de E-mail: Resend (prioridade 1) ─────────────────────────────────────

# Se RESEND_API_KEY estiver preenchida, usa a Resend para enviar e-mails.
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
RESEND_FROM_EMAIL=certy.zerocert@send.likncorp.com
RESEND_FROM_NAME=Certy by ZeroCert

# ── Envio de E-mail: SMTP (fallback) ──────────────────────────────────────────

# Se SMTP_HOST estiver preenchido e RESEND_API_KEY vazio, usa SMTP.
# Se ambos vazios, o código de verificação é apenas logado no console (modo dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Certy
SMTP_STARTTLS=true

# ── DNS ───────────────────────────────────────────────────────────────────────

# Resolver DoH usado para pré-checagem dos registros TXT antes de acionar a CA
DNS_CHECK_RESOLVER_URL=https://dns.google/resolve
DNS_CHECK_TIMEOUT_MS=4500

# ── ACME / Let's Encrypt ──────────────────────────────────────────────────────

# URL direta da CA. Se vazio, usa Let's Encrypt (Production ou Staging, veja abaixo).
ACME_DIRECTORY_URL=

# true → Let's Encrypt Staging (sem rate limit severo, ideal para testes).
# Só tem efeito quando ACME_DIRECTORY_URL está vazio.
ACME_USE_STAGING=false

# E-mail de contato para a conta ACME compartilhada (opcional).
ACME_ACCOUNT_CONTACT_EMAIL=

# Credenciais JSON de uma conta ACME existente (opcional).
# Se preenchido, o backend reutiliza e sincroniza no banco.
ACME_ACCOUNT_CREDENTIALS_JSON=

# ── Sessão ────────────────────────────────────────────────────────────────────

SESSION_TTL_MINUTES=60

# ── Polling ACME ─────────────────────────────────────────────────────────────

ACME_POLL_TIMEOUT_SECONDS=120
ACME_POLL_INITIAL_DELAY_MS=500
# Fator de backoff exponencial (deve ser > 1.0)
ACME_POLL_BACKOFF=1.8

# ── Logs ─────────────────────────────────────────────────────────────────────

RUST_LOG=info
